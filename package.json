{
  "name": "sbng-front-service",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3004",
    "build": "next build",
    "postbuild": "node scripts/sanitize-build.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint",
    "archive:articles": "node scripts/archive-article-sources.mjs",
    "test": "node --test scripts/*.test.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "format": "prettier --write app next.config.ts scripts/*.test.mjs scripts/verify-*.mjs"
  },
  "dependencies": {
    "@next/env": "^16.3.4",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.4",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24"
  }
}
