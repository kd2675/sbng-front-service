# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Legacy inquiry records and backups remain private; preserve the placeholder.
/data/*
!/data/.gitkeep
/data.lock

# Local IDE metadata
/.idea/
/.vscode/
*.iml
*.iws
*.ipr

# Local agent/tool artifacts
.codex/
.claude/
artifacts/
/.cache/
/.turbo/
/.playwright-cli/
/output/playwright/
/test-results/
/playwright-report/
/blob-report/
